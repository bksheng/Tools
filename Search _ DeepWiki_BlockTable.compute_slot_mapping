<span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">else</span><span>:  
</span><span>            </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 其他设备使用标准的 reshape_and_cache  </span><span>
</span>            torch_npu._npu_reshape_and_cache(  
                key=key[:attn_metadata.num_actual_tokens],  
                value=value[:attn_metadata.num_actual_tokens],  
