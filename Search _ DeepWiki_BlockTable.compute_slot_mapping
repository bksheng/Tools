</span><span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> self.key_cache </span><span style="color: rgb(51, 51, 51); font-weight: bold;">is</span><span> </span><span style="color: rgb(0, 128, 128);">None</span><span>:  
</span><span>            self.key_cache, self.value_cache = kv_cache[</span><span style="color: rgb(0, 128, 128);">0</span><span>], kv_cache[</span><span style="color: rgb(0, 128, 128);">1</span><span>]  
</span>          
        slots = attn_metadata.slot_mapping  
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># A5 设备使用特殊的 scatter 操作  </span><span>
</span><span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> get_ascend_device_type() == AscendDeviceType.A5:  
</span>            torch_npu.npu_scatter_pa_kv_cache(  
                key=key[:attn_metadata.num_actual_tokens],  
                value=value[:attn_metadata.num_actual_tokens].contiguous(),  
                key_cache=self.key_cache,  
