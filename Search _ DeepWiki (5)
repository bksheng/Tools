</span>  
<span></span><span style="color: rgb(153, 153, 136); font-style: italic;"># logical_q_idx: 假设decode场景，从位置504开始  </span><span>
</span><span>logical_q_idx = tensor([</span><span style="color: rgb(0, 128, 128);">504</span><span>, </span><span style="color: rgb(0, 128, 128);">505</span><span>, </span><span style="color: rgb(0, 128, 128);">506</span><span>, </span><span style="color: rgb(0, 128, 128);">507</span><span>])  
</span>  
<span></span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算每个query能attend到的最小KV位置  </span><span>
</span><span>min_kv_idx = clamp(logical_q_idx - (sliding_window - </span><span style="color: rgb(0, 128, 128);">1</span><span>), </span><span style="color: rgb(0, 134, 179);">min</span><span>=</span><span style="color: rgb(0, 128, 128);">0</span><span>)  
