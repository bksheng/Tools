<p>下面是一个独立的测试用例，完整提取了vLLM中block_mask的构建逻辑，并对比使用与不使用block_mask对attention计算的性能影响：</p>
<pre class="px-2 py-1.5 has-[code]:rounded-md has-[code]:!bg-[#e5e5e5] has-[div]:bg-transparent has-[div]:!p-0 has-[code]:text-stone-900 dark:has-[code]:!bg-[#242424] has-[code]:dark:text-white [&amp;_code]:block [&amp;_code]:border-none [&amp;_code]:bg-transparent [&amp;_code]:p-0"><pre style="display: block; overflow-x: auto; padding: 6px 8px; color: rgb(51, 51, 51); background: transparent; margin: 0px; width: 100%;"><code style="white-space: pre; font-size: 12px;"><span style="color: rgb(51, 51, 51); font-weight: bold;">import</span><span> torch  
</span><span></span><span style="color: rgb(51, 51, 51); font-weight: bold;">import</span><span> time  
</span><span></span><span style="color: rgb(51, 51, 51); font-weight: bold;">import</span><span> math  
</span><span></span><span style="color: rgb(51, 51, 51); font-weight: bold;">from</span><span> typing </span><span style="color: rgb(51, 51, 51); font-weight: bold;">import</span><span> </span><span style="color: rgb(68, 85, 136); font-weight: bold;">Optional</span><span>  
</span>  
<span></span><span class="hljs-function" style="color: rgb(51, 51, 51); font-weight: bold;">def</span><span class="hljs-function"> </span><span class="hljs-function" style="color: rgb(153, 0, 0); font-weight: bold;">extract_block_mask_logic</span><span class="hljs-function">(</span><span class="hljs-function hljs-params">  
</span><span class="hljs-function hljs-params">    seq_len: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    sliding_window: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    block_size: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    num_tokens: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    device: torch.device  
</span><span class="hljs-function hljs-params"></span><span class="hljs-function">) -&gt; torch.Tensor:</span><span>  
</span><span>    </span><span style="color: rgb(221, 17, 68);">"""  
</span><span style="color: rgb(221, 17, 68);">    完整提取vLLM中的block_mask构建逻辑  
</span><span style="color: rgb(221, 17, 68);">    对应代码: vllm/v1/attention/backends/flex_attention.py:532-546  
</span><span style="color: rgb(221, 17, 68);">    """</span><span>  
</span><span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 模拟doc_ids - 每个token属于哪个序列  </span><span>
</span>    doc_ids = torch.zeros(num_tokens, dtype=torch.int32, device=device)  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 模拟query_start_loc - 每个序列的起始位置  </span><span>
</span><span>    query_start_loc = torch.tensor([</span><span style="color: rgb(0, 128, 128);">0</span><span>], dtype=torch.int32, device=device)  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 模拟decode_offset - decode时的偏移量  </span><span>
</span><span>    decode_offset = torch.zeros(</span><span style="color: rgb(0, 128, 128);">1</span><span>, dtype=torch.int32, device=device)  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 创建logical_block_ids: [0, 1, 2, ..., max_blocks]  </span><span>
</span>    max_blocks = math.ceil(seq_len / block_size)  
    logical_block_ids = torch.arange(  
        max_blocks, device=device, dtype=torch.long  
    )  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 创建used_pages - 模拟block_table  </span><span>
</span>    used_pages = torch.arange(  
        max_blocks, device=device, dtype=torch.long  
<span>    ).unsqueeze(</span><span style="color: rgb(0, 128, 128);">0</span><span>).expand(num_tokens, -</span><span style="color: rgb(0, 128, 128);">1</span><span>)  
</span>      
<span>    </span><span style="color: rgb(0, 134, 179);">print</span><span>(</span><span style="color: rgb(221, 17, 68);">f"=== Block Mask构建过程 ==="</span><span>)  
</span><span>    </span><span style="color: rgb(0, 134, 179);">print</span><span>(</span><span style="color: rgb(221, 17, 68);">f"原始used_pages形状: </span><span style="color: rgb(51, 51, 51); font-weight: normal;">{used_pages.shape}</span><span style="color: rgb(221, 17, 68);">"</span><span>)  
</span><span>    </span><span style="color: rgb(0, 134, 179);">print</span><span>(</span><span style="color: rgb(221, 17, 68);">f"原始used_pages:\n</span><span style="color: rgb(51, 51, 51); font-weight: normal;">{used_pages[</span><span style="color: rgb(0, 128, 128); font-weight: normal;">0</span><span style="color: rgb(51, 51, 51); font-weight: normal;">]}</span><span style="color: rgb(221, 17, 68);">"</span><span>)  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 完整复制vLLM的block_mask构建逻辑  </span><span>
</span><span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> sliding_window &gt; </span><span style="color: rgb(0, 128, 128);">0</span><span>:  
</span>        device = used_pages.device  
          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 步骤1: 创建token索引  </span><span>
</span>        token_indices = torch.arange(  
            num_tokens, device=device, dtype=torch.long  
        )  
<span>        </span><span style="color: rgb(0, 134, 179);">print</span><span>(</span><span style="color: rgb(221, 17, 68);">f"token_indices: </span><span style="color: rgb(51, 51, 51); font-weight: normal;">{token_indices}</span><span style="color: rgb(221, 17, 68);">"</span><span>)  
</span>          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 步骤2: 计算逻辑query索引  </span><span>
</span>        logical_q_idx = (  
            token_indices  
            - query_start_loc[doc_ids]  
            + decode_offset[doc_ids]  
        )  
<span>        </span><span style="color: rgb(0, 134, 179);">print</span><span>(</span><span style="color: rgb(221, 17, 68);">f"logical_q_idx: </span><span style="color: rgb(51, 51, 51); font-weight: normal;">{logical_q_idx}</span><span style="color: rgb(221, 17, 68);">"</span><span>)  
</span>          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 步骤3: 计算每个query能attend到的最小KV索引  </span><span>
</span>        min_kv_idx = torch.clamp(  
