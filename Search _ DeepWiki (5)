</span><span class="hljs-function hljs-params">    query: torch.Tensor,  
</span><span class="hljs-function hljs-params">    key_cache: torch.Tensor,  
</span><span class="hljs-function hljs-params">    value_cache: torch.Tensor,  
</span><span class="hljs-function hljs-params">    block_tables: torch.Tensor,  
</span><span class="hljs-function hljs-params">    seq_lens: torch.Tensor,  
</span><span class="hljs-function hljs-params">    sliding_window: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    block_size: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    query_start_loc: torch.Tensor,  
</span><span class="hljs-function hljs-params">    decode_offset: torch.Tensor,  
</span><span class="hljs-function hljs-params"></span><span class="hljs-function">):</span><span>  
</span><span>    </span><span style="color: rgb(221, 17, 68);">"""实现per-token级别的sliding window"""</span><span>  
</span>    device = query.device  
<span>    num_tokens = query.shape[</span><span style="color: rgb(0, 128, 128);">0</span><span>]  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 1. 计算每个token的mask（严格按原始逻辑）  </span><span>
</span>    token_indices = torch.arange(num_tokens, device=device)  
    doc_ids = _offsets_to_doc_ids_tensor(query_start_loc)  
    logical_q_idx = (  
        token_indices  
        - query_start_loc[doc_ids]  
        + decode_offset[doc_ids]  
    )  
    min_kv_idx = torch.clamp(  
<span>        logical_q_idx - (sliding_window - </span><span style="color: rgb(0, 128, 128);">1</span><span>), </span><span style="color: rgb(0, 134, 179);">min</span><span>=</span><span style="color: rgb(0, 128, 128);">0</span><span>  
</span>    )  
    min_block_idx = min_kv_idx // block_size  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 2. 为每个token创建独立的block table  </span><span>
</span><span>    max_blocks = block_tables.shape[</span><span style="color: rgb(0, 128, 128);">1</span><span>]  
</span>    logical_block_ids = torch.arange(max_blocks, device=device)  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 3. 按mask模式分组tokens  </span><span>
</span>    unique_masks, inverse_indices = torch.unique(  
<span>        min_block_idx, dim=</span><span style="color: rgb(0, 128, 128);">0</span><span>, return_inverse=</span><span style="color: rgb(0, 128, 128);">True</span><span>  
</span>    )  
      
    outputs = []  
<span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">for</span><span> mask_id </span><span style="color: rgb(51, 51, 51); font-weight: bold;">in</span><span> </span><span style="color: rgb(0, 134, 179);">range</span><span>(</span><span style="color: rgb(0, 134, 179);">len</span><span>(unique_masks)):  
</span><span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 获取具有相同mask的tokens  </span><span>
</span>        token_mask = inverse_indices == mask_id  
<span>        group_tokens = torch.where(token_mask)[</span><span style="color: rgb(0, 128, 128);">0</span><span>]  
</span>          
<span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> </span><span style="color: rgb(0, 134, 179);">len</span><span>(group_tokens) == </span><span style="color: rgb(0, 128, 128);">0</span><span>:  
</span><span>            </span><span style="color: rgb(51, 51, 51); font-weight: bold;">continue</span><span>  
</span>          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 为该组创建统一的block table  </span><span>
</span>        group_min_block_idx = unique_masks[mask_id]  
        group_mask = logical_block_ids &gt;= group_min_block_idx  
        group_block_table = block_tables.clone()  
          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 应用mask到所有相关序列  </span><span>
</span><span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">for</span><span> seq_idx </span><span style="color: rgb(51, 51, 51); font-weight: bold;">in</span><span> torch.unique(doc_ids[token_mask]):  
</span>            seq_tokens = token_mask &amp; (doc_ids == seq_idx)  
<span>            </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> seq_tokens.</span><span style="color: rgb(0, 134, 179);">any</span><span>():  
</span><span>                group_block_table[seq_idx, ~group_mask] = </span><span style="color: rgb(0, 128, 128);">0</span><span>  
</span>          
<span>        </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 调用NPU算子处理这组tokens  </span><span>
</span>        group_query = query[group_tokens]  
        group_output = torch_npu._npu_paged_attention(  
            group_query,  
            key_cache,  
            value_cache,  
            group_block_table,  
            seq_lens,  
<span>            </span><span style="color: rgb(153, 153, 136); font-style: italic;"># ... 其他参数  </span><span>
</span>        )  
        outputs.append(group_output)  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 4. 合并结果  </span><span>
</span>    result = torch.zeros_like(query)  
<span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">for</span><span> mask_id, group_output </span><span style="color: rgb(51, 51, 51); font-weight: bold;">in</span><span> </span><span style="color: rgb(0, 134, 179);">enumerate</span><span>(outputs):  
</span>        token_mask = inverse_indices == mask_id  
        result[token_mask] = group_output  
      
<span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">return</span><span> result</span></code></pre></pre>
<h3 class="group">方案三：混合实现（推荐）  </h3>
<p>结合性能和精度考虑，采用自适应策略：</p>
<pre class="px-2 py-1.5 has-[code]:rounded-md has-[code]:!bg-[#e5e5e5] has-[div]:bg-transparent has-[div]:!p-0 has-[code]:text-stone-900 dark:has-[code]:!bg-[#242424] has-[code]:dark:text-white [&amp;_code]:block [&amp;_code]:border-none [&amp;_code]:bg-transparent [&amp;_code]:p-0"><pre style="display: block; overflow-x: auto; padding: 6px 8px; color: rgb(51, 51, 51); background: transparent; margin: 0px; width: 100%;"><code style="white-space: pre; font-size: 12px;"><span class="hljs-function" style="color: rgb(51, 51, 51); font-weight: bold;">def</span><span class="hljs-function"> </span><span class="hljs-function" style="color: rgb(153, 0, 0); font-weight: bold;">adaptive_sliding_window_npu</span><span class="hljs-function">(</span><span class="hljs-function hljs-params">  
</span><span class="hljs-function hljs-params">    query, key_cache, value_cache, block_tables, seq_lens,  
</span><span class="hljs-function hljs-params">    sliding_window, block_size, query_start_loc, decode_offset  
</span><span class="hljs-function hljs-params"></span><span class="hljs-function">):</span><span>  
</span><span>    </span><span style="color: rgb(221, 17, 68);">"""自适应的sliding window实现"""</span><span>  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算token级别的mask差异  </span><span>
</span><span>    token_indices = torch.arange(query.shape[</span><span style="color: rgb(0, 128, 128);">0</span><span>], device=query.device)  
</span>    doc_ids = _offsets_to_doc_ids_tensor(query_start_loc)  
    logical_q_idx = (  
        token_indices - query_start_loc[doc_ids] + decode_offset[doc_ids]  
    )  
    min_block_idx = torch.clamp(  
<span>        logical_q_idx - (sliding_window - </span><span style="color: rgb(0, 128, 128);">1</span><span>), </span><span style="color: rgb(0, 134, 179);">min</span><span>=</span><span style="color: rgb(0, 128, 128);">0</span><span>  
</span>    ) // block_size  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 检查是否需要per-token处理  </span><span>
</span>    unique_masks = torch.unique(min_block_idx)  
      
<span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">if</span><span> </span><span style="color: rgb(0, 134, 179);">len</span><span>(unique_masks) &lt;= </span><span style="color: rgb(0, 128, 128);">4</span><span>:  </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 如果mask种类较少，使用分组处理  </span><span>
</span><span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">return</span><span> per_token_sliding_window_npu(...)  
</span><span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">else</span><span>:  </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 否则使用per-sequence的近似实现  </span><span>
</span><span>        </span><span style="color: rgb(51, 51, 51); font-weight: bold;">return</span><span> mask_block_tables_for_sliding_window_strict(...)</span></code></pre></pre>
<h2 class="group">实现建议  </h2>
<ol>
<li><strong>性能评估</strong>：per-token实现会增加多次kernel调用开销，需要评估是否值得</li>
<li><strong>内存开销</strong>：每个token独立的block table会显著增加内存使用</li>
<li><strong>NPU限制</strong>：确认NPU硬件是否支持动态block table索引</li>
</ol>
<h2 class="group">Notes  </h2>
<ul>
<li>真正的per-token实现需要NPU硬件支持或多次kernel调用</li>
<li>实际性能提升可能被额外的kernel调用开销抵消</li>
<li>建议先实现per-sequence版本，根据实际需求决定是否优化到per-token级别</li>
<li>可以考虑在NPU驱动层面添加对per-token mask的支持</li>
</ul>
