</span><span class="hljs-function hljs-params">                </span><span class="hljs-function hljs-params" style="color: rgb(51, 51, 51); font-weight: bold;">const</span><span class="hljs-function hljs-params"> </span><span class="hljs-function hljs-params" style="color: rgb(51, 51, 51); font-weight: bold;">int32_t</span><span class="hljs-function hljs-params"> sliding_window_right)</span><span class="hljs-function"> </span><span>{  
