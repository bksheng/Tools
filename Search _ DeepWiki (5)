<span>    -v </span><span>--model</span><span>=</span><span style="color: rgb(221, 17, 68);">"bigcode/starcoder2-3b"</span><span> \  
</span><span>    </span><span>--batch_size</span><span>=</span><span style="color: rgb(0, 128, 128);">5</span><span> \  
