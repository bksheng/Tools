</span><span>num_tokens = </span><span style="color: rgb(0, 128, 128);">4</span><span>  </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 4个query tokens  </span><span>
</span>  
<span></span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算基础值  </span><span>
