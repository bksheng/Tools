<h3 class="group">性能优化版本  </h3>
<p>使用向量化操作提升性能：</p>
<pre class="px-2 py-1.5 has-[code]:rounded-md has-[code]:!bg-[#e5e5e5] has-[div]:bg-transparent has-[div]:!p-0 has-[code]:text-stone-900 dark:has-[code]:!bg-[#242424] has-[code]:dark:text-white [&amp;_code]:block [&amp;_code]:border-none [&amp;_code]:bg-transparent [&amp;_code]:p-0"><pre style="display: block; overflow-x: auto; padding: 6px 8px; color: rgb(51, 51, 51); background: transparent; margin: 0px; width: 100%;"><code style="white-space: pre; font-size: 12px;"><span class="hljs-function" style="color: rgb(51, 51, 51); font-weight: bold;">def</span><span class="hljs-function"> </span><span class="hljs-function" style="color: rgb(153, 0, 0); font-weight: bold;">mask_block_tables_for_sliding_window_vectorized</span><span class="hljs-function">(</span><span class="hljs-function hljs-params">  
</span><span class="hljs-function hljs-params">    block_tables: torch.Tensor,  
</span><span class="hljs-function hljs-params">    seq_lens: torch.Tensor,  
</span><span class="hljs-function hljs-params">    sliding_window: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params">    block_size: </span><span class="hljs-function hljs-params" style="color: rgb(0, 134, 179);">int</span><span class="hljs-function hljs-params">,  
</span><span class="hljs-function hljs-params"></span><span class="hljs-function">) -&gt; torch.Tensor:</span><span>  
</span><span>    </span><span style="color: rgb(221, 17, 68);">"""向量化的block table掩码实现"""</span><span>  
</span>    masked_block_tables = block_tables.clone()  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算每个序列的总block数  </span><span>
</span><span>    total_blocks = (seq_lens + block_size - </span><span style="color: rgb(0, 128, 128);">1</span><span>) // block_size  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算滑动窗口内的token数  </span><span>
</span>    window_tokens = torch.minimum(seq_lens, torch.tensor(sliding_window))  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算需要保留的block数  </span><span>
</span><span>    num_blocks_to_keep = (window_tokens + block_size - </span><span style="color: rgb(0, 128, 128);">1</span><span>) // block_size  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 计算第一个需要保留的block索引  </span><span>
</span>    first_block_indices = total_blocks - num_blocks_to_keep  
      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 创建掩码：只有需要保留的block位置为True  </span><span>
</span><span>    seq_range = torch.arange(block_tables.shape[</span><span style="color: rgb(0, 128, 128);">1</span><span>], device=block_tables.device)  
</span><span>    mask = seq_range[</span><span style="color: rgb(0, 128, 128);">None</span><span>, :] &gt;= first_block_indices[:, </span><span style="color: rgb(0, 128, 128);">None</span><span>]  
</span>      
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># 应用掩码  </span><span>
</span><span>    masked_block_tables = torch.where(mask, block_tables, </span><span style="color: rgb(0, 128, 128);">0</span><span>)  
</span>      
<span>    </span><span style="color: rgb(51, 51, 51); font-weight: bold;">return</span><span> masked_block_tables</span></code></pre></pre>
