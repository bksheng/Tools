    query,  
    key_cache,  
    value_cache,  
<span>    block_tables_per_token,  </span><span style="color: rgb(153, 153, 136); font-style: italic;"># [num_tokens, max_blocks_per_token] 而不是 [num_seqs, max_blocks]  </span><span>
</span>    seq_lens,  
<span>    </span><span style="color: rgb(153, 153, 136); font-style: italic;"># ...  </span><span>
</span>)</code></pre></pre>
