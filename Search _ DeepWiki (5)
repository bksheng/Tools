<table><thead><tr><th>实现方式</th><th>GPU (FlexAttention)</th><th>NPU (Ascend)</th></tr></thead><tbody><tr><td>掩码位置</td><td>在attention计算中动态应用</td><td>在调用算子前静态预处理</td></tr><tr><td>掩码对象</td><td>block_mask + score_mod</td><td>block_tables</td></tr><tr><td>内存访问</td><td>只加载窗口内blocks</td><td>加载所有blocks但跳过无效block</td></tr><tr><td>实现复杂度</td><td>需要mask函数组合</td><td>直接修改block_tables</td></tr></tbody></table>
